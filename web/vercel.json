{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/troid.js": {
      "includeFiles": "{context,public,i18n}/*.{json,md}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/:lang(zh|hi|es|ar|fr|bn|pt|ru|id)",
      "destination": "/:lang/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "troid-one.vercel.app"
        }
      ],
      "destination": "https://troid.ai/:path*",
      "permanent": true
    }
  ]
}
