# troid Pro: placeholders only (handoff "Stripe Managed Payments for troid Pro", 2026-09-26). Real values live in
# Vercel → project troid → Settings → Environment Variables: test values in Preview now, live values in Production only
# after the launch gates clear. The owner copies them from the Stripe and Supabase dashboards: never into a chat,
# GitHub or this file. ask troid's settings are listed in web/README.md.

# "test" on Preview (refused on production and with a live key); "live" in Production after the gates. Unset: off.
TROID_PRO=

# Stripe → Developers → API keys. A restricted key (web/README.md lists its permissions); it starts rk_test_ in test mode.
STRIPE_SECRET_KEY=
# Starts pk_test_ in test mode. The hosted Checkout doesn't use it; if it is set, its mode must match the secret key's.
STRIPE_PUBLISHABLE_KEY=
# Stripe → Developers → Webhooks → the /api/stripe-webhook endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=
# troid Pro's two price IDs (price_…): Product catalog → troid Pro, or node web/pro_prices.js.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Supabase → Project Settings → API keys. The URL and the publishable key are public by design; the secret key is not.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional, test mode only: "on" puts each first checkout's customer on a Stripe test clock (web/README.md, troid Pro).
TROID_PRO_TEST_CLOCK=
